{
  "name": "learning-mentor-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "A local desktop companion for long-term goals, powered by your own Codex agent",
  "main": "src/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/build.cjs",
    "setup:electron": "node scripts/install-electron.cjs",
    "start": "npm run build && electron .",
    "test": "node --test test/*.test.cjs",
    "test:desktop": "npm run build && node scripts/test-desktop-flow.cjs",
    "mcp": "node src/mcp.cjs",
    "package": "npm run build && node scripts/package.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sql.js": "1.17.0"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "esbuild": "^0.27.0",
    "@electron/packager": "^19.0.0"
  }
}
